# 统一换行符：文本文件按 autocrlf，代码/配置类强制 LF，二进制不转换
* text=auto

*.py     text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.jsx    text eol=lf
*.tsx    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.sh     text eol=lf
*.lock   text eol=lf
*.bat    text eol=crlf
Dockerfile          text eol=lf
.dockerignore       text eol=lf
.gitignore          text eol=lf
.gitattributes      text eol=lf
requirements*.txt   text eol=lf

# 二进制文件（禁止任何转换）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.docx  binary
*.index binary
*.npy   binary
