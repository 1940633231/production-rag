PYTHONPATH=${workspaceFolder}

# auth / rbac（JWT 密钥，生产必须设置；未设置时回退 config.yaml 的 auth.jwt_secret）
JWT_SECRET=

# dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=production_rag  
# .env
ES_HOSTS=http://127.0.0.1:9200
ES_USER=elastic
ES_PASSWORD=
ES_INDEX_PREFIX=production_rag
ES_TIMEOUT=30

# milvus
MILVUS_HOST=172.20.48.223
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=production_rag
